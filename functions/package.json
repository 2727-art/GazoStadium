{
  "name": "gazostadium-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "check": "node --check index.js && node --test test/*.test.js",
    "test:emulator": "node --test --test-concurrency=1 test/*emulator.test.js",
    "test:free-table-callable-emulator": "node test/run-free-table-callable-emulator.js",
    "test:free-table-callable-emulator:run": "node --test --test-concurrency=1 test/free-table-callable-emulator.test.js",
    "test:flea-emulator": "node test/run-anju-pay-flea-e2e-emulator.js",
    "test:flea-emulator:run": "node --test --test-concurrency=1 test/anju-pay-flea-e2e-emulator.test.js",
    "serve": "firebase emulators:start --only auth,functions,firestore,database --project demo-gazostadium",
    "build:client": "node ../scripts/build-landing.cjs && node ../scripts/build-market-records.cjs"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "acorn": "8.15.0",
    "firebase": "12.19.0",
    "postcss": "8.5.6"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "uuid": "11.1.1"
  }
}
