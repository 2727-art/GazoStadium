// Cloudflare Workers Builds deploys main with npx wrangler deploy.
{
  "name": "gazostadium",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index",
      "/index.html",
      "/modes",
      "/modes/*",
      "/how-to-play",
      "/how-to-play/*",
      "/strategy",
      "/strategy/*",
      "/solo-training",
      "/solo-training/*",
      "/safety",
      "/safety/*",
      "/faq",
      "/faq/*"
    ]
  },
  "main": "scripts/legacy-worker.mjs",
  "build": {
    "command": "node scripts/prepare-legacy-hosting.cjs"
  }
}
