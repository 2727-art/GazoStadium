{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix functions run check"
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "GazoStadium",
        "supportEmail": "at.kga.dmt.pjam.t2727@gmail.com"
      }
    }
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9000
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    }
  },
  "hosting": {
    "site": "gazostadium",
    "public": ".",
    "headers": [
      {
        "source": "/assets/landing/hero-example.d9a004076802.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "_headers",
      ".firebaserc",
      "database.rules.json",
      "README.md",
      "ANJU_PAY_FLEA_DESIGN.md",
      "AI_TEXT_TRAINING_DESIGN.md",
      "ROULETTE_TRAINING_DESIGN.md",
      "STRATEGY_HARIAI_DESIGN.md",
      "TRIBUTE_DESIGN.md",
      ".codex-remote-attachments",
      ".codex-remote-attachments/**",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "database-debug.log",
      "firestore-debug.log",
      "ui-debug.log",
      "firestore.rules",
      "firestore.indexes.json",
      "functions",
      "functions/**",
      "**/.*",
      ".claude",
      ".claude/**",
      "**/node_modules/**"
    ]
  }
}
