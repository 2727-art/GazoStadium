rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isRoomMember() {
      return signedIn() && resource.data.participants[request.auth.uid] == true;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /anjuPayEntries/{entryId} {
        allow read, write: if false;
      }
    }

    match /systemConfig/{configId} {
      allow read, write: if false;
    }

    match /economyProgress/{uid} {
      allow read, write: if false;
    }

    match /verifiedMatchClaims/{claimId} {
      allow read, write: if false;
    }

    match /soloProfileProjectionQueues/{uid} {
      allow read, write: if false;

      match /jobs/{jobId} {
        allow read, write: if false;
      }
    }

    match /postMatchTips/{tipId} {
      allow read, write: if false;
    }

    match /soloFamiliarIntents/{intentId} {
      allow read, write: if false;
    }

    match /soloFamiliarPairs/{pairId} {
      allow read, write: if false;
    }

    match /soloFamiliarBooks/{uid} {
      allow read, write: if false;

      match /familiarEntries/{entryId} {
        allow read, write: if false;
      }
    }

    match /soloFamiliarBlocks/{uid} {
      allow read, write: if false;

      match /blockEntries/{entryId} {
        allow read, write: if false;
      }
    }

    match /soloFamiliarBlockPairs/{pairId} {
      allow read, write: if false;
    }

    match /soloFamiliarReunions/{reunionId} {
      allow read, write: if false;
    }

    match /achievementProfiles/{uid} {
      allow read, write: if false;
    }

    // 断惑NOTEは、本人の記録も公開用ミラーもCallable Functionsだけが扱います。
    match /danwakuProfiles/{uid} {
      allow read, write: if false;

      match /notes/{noteId} {
        allow read, write: if false;

        match /events/{eventId} {
          allow read, write: if false;
        }
      }

      match /operations/{operationId} {
        allow read, write: if false;
      }
    }

    match /danwakuPublicEntries/{entryId} {
      allow read, write: if false;
    }

    match /danwakuMatchBadges/{uid} {
      allow read, write: if false;
    }

    match /danwakuDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    // 戦略型1on1の成立時スナップショットは、公開フェーズまでAdmin SDKだけが保持します。
    match /strategyMatchAchievementFreezes/{roomId} {
      allow read, write: if false;
    }

    match /achievementCodeRedemptions/{uid} {
      allow read, write: if false;

      match /codes/{codeId} {
        allow read, write: if false;
      }
    }

    match /crownMonthlyAchievementStats/{uid} {
      allow read, write: if false;
    }

    match /serverRankingProfiles/{uid} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if false;
      }

      match /crownRuns/{runId} {
        allow read, write: if false;
      }

      match /awards/{awardId} {
        allow read, write: if false;
      }
    }

    match /serverRankingPeriods/{periodKey}/entries/{uid} {
      allow read, write: if false;
    }

    match /crownCircuitPeriods/{periodKey} {
      allow read, write: if false;

      match /entries/{uid} {
        allow read, write: if false;
      }
    }

    match /valueMarketPatrons/{uid} {
      allow read, write: if false;
    }

    match /valueMarketPatronLedger/{entryId} {
      allow read, write: if false;
    }

    match /valueMarketPatronFunds/{seasonKey} {
      allow read, write: if false;
    }

    match /valueMarketPatronFundContributors/{contributorId} {
      allow read, write: if false;
    }

    match /valueMarketPatronFundPairs/{pairId} {
      allow read, write: if false;
    }

    match /valueMarketPatronSellerImpacts/{impactId} {
      allow read, write: if false;
    }

    match /valueMarketPatronPolicies/{seasonKey} {
      allow read, write: if false;
    }

    match /valueMarketPatronPolicyVotes/{voteId} {
      allow read, write: if false;

      match /actions/{actionId} {
        allow read, write: if false;
      }
    }

    match /valueMarketPatronRecommendationProfiles/{profileId} {
      allow read, write: if false;
    }

    match /valueMarketPatronRecommendationSeasons/{seasonKey} {
      allow read, write: if false;

      match /shops/{publicSellerId} {
        allow read, write: if false;
      }
    }

    // AnjuPayフリマは一覧を含む全操作をCallable経由に限定し、UIDを公開しません。
    match /anjuPayFleaListings/{listingId} {
      allow read, write: if false;
    }

    match /anjuPayFleaSellerCards/{uid} {
      allow read, write: if false;
    }

    match /anjuPayFleaAchievementStats/{uid} {
      allow read, write: if false;
    }

    match /anjuPayFleaFavorites/{uid} {
      allow read, write: if false;

      match /sellers/{publicSellerId} {
        allow read, write: if false;
      }
    }

    match /anjuPayFleaReceipts/{uid} {
      allow read, write: if false;

      match /items/{receiptId} {
        allow read, write: if false;
      }
    }

    match /anjuPayFleaSales/{listingId} {
      allow read, write: if false;
    }

    match /anjuPayFleaReports/{reportId} {
      allow read, write: if false;
    }

    // 文字コラトレーニングの台本・利用・売上・X公開はすべてCallableで検証します。
    match /aiTextTrainingPresets/{presetId} {
      allow read, write: if false;

      match /revisions/{revisionId} {
        allow read, write: if false;
      }
    }

    match /aiTextTrainingSellerProfiles/{uid} {
      allow read, write: if false;
    }

    match /aiTextTrainingPreferences/{uid} {
      allow read, write: if false;
    }

    match /aiTextTrainingUses/{useId} {
      allow read, write: if false;
    }

    match /aiTextTrainingActiveUses/{uid} {
      allow read, write: if false;
    }

    match /aiTextTrainingPlayerStats/{uid} {
      allow read, write: if false;
    }

    match /aiTextTrainingAchievementSessions/{sessionId} {
      allow read, write: if false;
    }

    match /aiTextTrainingActiveAchievementSessions/{uid} {
      allow read, write: if false;
    }

    match /aiTextTrainingPublishActions/{actionId} {
      allow read, write: if false;
    }

    match /aiTextTrainingSellerStats/{uid} {
      allow read, write: if false;
    }

    match /aiTextTrainingMonthlyPeriods/{periodKey} {
      allow read, write: if false;

      match /entries/{uid} {
        allow read, write: if false;
      }
    }

    match /aiTextTrainingRankingPairs/{pairId} {
      allow read, write: if false;
    }

    match /aiTextTrainingSellerBuyerPairs/{pairId} {
      allow read, write: if false;
    }

    match /aiTextTrainingMonthlyBuyerPairs/{pairId} {
      allow read, write: if false;
    }

    match /aiTextTrainingPresetRevisionBuyers/{revisionBuyerId} {
      allow read, write: if false;
    }

    match /aiTextTrainingReports/{reportId} {
      allow read, write: if false;
    }

    match /accountTransferCodes/{codeHash} {
      allow read, write: if false;
    }

    match /accountTransferSources/{uid} {
      allow read, write: if false;
    }

    match /accountTransferAttempts/{uid} {
      allow read, write: if false;
    }

    match /valueMarketActive/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /valueMarketRooms/{roomId} {
      allow read: if isRoomMember();
      allow write: if false;
    }

    match /valueMarketQueues/{uid} {
      allow read, write: if false;
    }

    match /valueMarketQueueControls/{uid} {
      allow read, write: if false;
    }

    match /valueMarketStats/{uid} {
      allow read, write: if false;
    }

    match /valueMarketShops/{uid} {
      allow read, write: if false;
    }

    match /valueMarketShopSalesModes/{uid} {
      allow read, write: if false;
    }

    match /valueMarketShopPublic/{publicSellerId} {
      allow read, write: if false;
    }

    match /valueMarketShopFavorites/{buyerUid} {
      allow read, write: if false;

      match /sellers/{sellerUid} {
        allow read, write: if false;
      }
    }

    match /valueMarketShopBlocks/{uid} {
      allow read, write: if false;

      match /users/{targetUid} {
        allow read, write: if false;
      }
    }

    match /valueMarketShopRelationships/{relationshipId} {
      allow read, write: if false;
    }

    match /valueMarketShopImpressions/{impressionId} {
      allow read, write: if false;
    }

    match /valueMarketLedger/{entryId} {
      allow read, write: if false;
    }

    match /valueMarketCertificates/{uid}/items/{certificateId} {
      allow read, write: if false;
    }

    match /valueMarketAchievementPairs/{pairId} {
      allow read, write: if false;
    }

    // 貼り合い自由卓の設定、成長、帰る場所、縁、ブロック、通報は
    // すべて App Check 強制の Callable から Admin SDK で扱います。
    match /freeTableProfiles/{uid} {
      allow read, write: if false;
    }

    match /freeTablePublicMembers/{publicMemberId} {
      allow read, write: if false;
    }

    match /freeTableSpaces/{uid} {
      allow read, write: if false;
    }

    match /freeTablePublicSpaces/{publicRoomId} {
      allow read, write: if false;
    }

    match /freeTableVisitLedger/{sessionId} {
      allow read, write: if false;
    }

    match /freeTablePairActivity/{pairId} {
      allow read, write: if false;
    }

    match /freeTableBookmarks/{uid} {
      allow read, write: if false;

      match /rooms/{publicRoomId} {
        allow read, write: if false;
      }
    }

    match /freeTableRelationships/{pairId} {
      allow read, write: if false;
    }

    match /freeTableBlocks/{uid} {
      allow read, write: if false;

      match /users/{publicMemberId} {
        allow read, write: if false;
      }
    }

    match /freeTableBlockPairs/{pairId} {
      allow read, write: if false;
    }

    match /freeTableReports/{reportId} {
      allow read, write: if false;
    }

    // 終了した鍛え合い60の統計・実績再現用プロフィールと確定台帳は
    // 履歴として保持する。クライアントからの読み書きは再開しない。
    match /trainingProfiles/{uid} {
      allow read, write: if false;
    }

    match /trainingClaims/{document=**} {
      allow read, write: if false;
    }

    match /trainingV6Claims/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
