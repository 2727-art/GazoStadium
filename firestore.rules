rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isRoomMember() {
      return signedIn() && resource.data.participants[request.auth.uid] == true;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /anjuPayEntries/{entryId} {
        allow read, write: if false;
      }
    }

    match /systemConfig/{configId} {
      allow read, write: if false;
    }

    match /economyProgress/{uid} {
      allow read, write: if false;
    }

    match /verifiedMatchClaims/{claimId} {
      allow read, write: if false;
    }

    match /postMatchTips/{tipId} {
      allow read, write: if false;
    }

    match /soloFamiliarIntents/{intentId} {
      allow read, write: if false;
    }

    match /soloFamiliarPairs/{pairId} {
      allow read, write: if false;
    }

    match /soloFamiliarBooks/{uid} {
      allow read, write: if false;

      match /familiarEntries/{entryId} {
        allow read, write: if false;
      }
    }

    match /soloFamiliarBlocks/{uid} {
      allow read, write: if false;

      match /blockEntries/{entryId} {
        allow read, write: if false;
      }
    }

    match /soloFamiliarBlockPairs/{pairId} {
      allow read, write: if false;
    }

    match /soloFamiliarReunions/{reunionId} {
      allow read, write: if false;
    }

    match /achievementProfiles/{uid} {
      allow read, write: if false;
    }

    match /serverRankingProfiles/{uid} {
      allow read, write: if false;

      match /entries/{entryId} {
        allow read, write: if false;
      }

      match /awards/{awardId} {
        allow read, write: if false;
      }
    }

    match /serverRankingPeriods/{periodKey}/entries/{uid} {
      allow read, write: if false;
    }

    match /valueMarketPatrons/{uid} {
      allow read, write: if false;
    }

    match /valueMarketPatronLedger/{entryId} {
      allow read, write: if false;
    }

    match /valueMarketPatronFunds/{seasonKey} {
      allow read, write: if false;
    }

    match /valueMarketPatronFundContributors/{contributorId} {
      allow read, write: if false;
    }

    match /valueMarketPatronFundPairs/{pairId} {
      allow read, write: if false;
    }

    match /valueMarketPatronSellerImpacts/{impactId} {
      allow read, write: if false;
    }

    match /valueMarketPatronPolicies/{seasonKey} {
      allow read, write: if false;
    }

    match /valueMarketPatronPolicyVotes/{voteId} {
      allow read, write: if false;

      match /actions/{actionId} {
        allow read, write: if false;
      }
    }

    match /valueMarketPatronRecommendationProfiles/{profileId} {
      allow read, write: if false;
    }

    match /valueMarketPatronRecommendationSeasons/{seasonKey} {
      allow read, write: if false;

      match /shops/{publicSellerId} {
        allow read, write: if false;
      }
    }

    match /accountTransferCodes/{codeHash} {
      allow read, write: if false;
    }

    match /accountTransferSources/{uid} {
      allow read, write: if false;
    }

    match /accountTransferAttempts/{uid} {
      allow read, write: if false;
    }

    match /valueMarketActive/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /valueMarketRooms/{roomId} {
      allow read: if isRoomMember();
      allow write: if false;
    }

    match /valueMarketQueues/{uid} {
      allow read, write: if false;
    }

    match /valueMarketQueueControls/{uid} {
      allow read, write: if false;
    }

    match /valueMarketStats/{uid} {
      allow read, write: if false;
    }

    match /valueMarketShops/{uid} {
      allow read, write: if false;
    }

    match /valueMarketShopPublic/{publicSellerId} {
      allow read, write: if false;
    }

    match /valueMarketShopFavorites/{buyerUid} {
      allow read, write: if false;

      match /sellers/{sellerUid} {
        allow read, write: if false;
      }
    }

    match /valueMarketShopBlocks/{uid} {
      allow read, write: if false;

      match /users/{targetUid} {
        allow read, write: if false;
      }
    }

    match /valueMarketShopRelationships/{relationshipId} {
      allow read, write: if false;
    }

    match /valueMarketShopImpressions/{impressionId} {
      allow read, write: if false;
    }

    match /valueMarketLedger/{entryId} {
      allow read, write: if false;
    }

    match /valueMarketCertificates/{uid}/items/{certificateId} {
      allow read, write: if false;
    }

    match /valueMarketAchievementPairs/{pairId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
